# ── OS / editor ─────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Dependencies (regenerated by composer / npm) ──
/backend/vendor/
/frontend/node_modules/
/backend/node_modules/

# ── Environment (secrets — copied from .env.example) ──
/backend/.env
/frontend/.env

# ── Build output ────────────────────────────
/frontend/dist/
/backend/public/build/
/backend/public/hot

# ── Laravel runtime ─────────────────────────
/backend/storage/*.key
/backend/public/storage
# NOTE: storage/app/public/{posters,actors} ARE committed so a fresh clone shows
# real images immediately (the DB backup references them). They re-download from
# TMDB on resync if missing.

# ── graphify generated knowledge graph (regenerate with /graphify) ──
/graphify-out/
