# ── OS / editor ─────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Dependencies (regenerated by composer / npm) ──
/backend/vendor/
/frontend/node_modules/
/backend/node_modules/

# ── Environment (secrets — copied from .env.example) ──
/backend/.env
/frontend/.env

# ── Build output ────────────────────────────
/frontend/dist/
/backend/public/build/
/backend/public/hot

# ── Laravel runtime ─────────────────────────
/backend/storage/*.key
/backend/public/storage
# NOTE: uploads and downloaded posters are NOT committed (storage/app/.gitignore
# ignores them). A fresh clone re-downloads posters/cast photos from TMDB via
# /sync (or `php artisan media:redownload`).

# ── Database dumps — never commit (Tasks SEC-01) ──
# A dump carries bcrypt hashes, remember tokens, live session ids, private chat
# and API tokens. Keep it local; move a library between machines with /backups.
*.sql
*.sql.gz

# ── dev-სკრიპტის ლოგები (start-dev.sh ორივეს რეპოს root-ში წერს) ──
/backend.log
/frontend.log

# ── graphify generated knowledge graph (regenerate with /graphify) ──
/graphify-out/

# ── temp helpers (i18n merge scripts, python caches) ──
/frontend/.tmp-i18n/
__pycache__/
