<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- ⚠️ **ერთი PHP პროცესი ატარებს მთელ ნაკრებს** (900+ ტესტი), ე.ი.
             აპლიკაციის ყოველი ხელახალი აწყობა მეხსიერებას უმატებს და ჯამი
             მხოლოდ იზრდება. CLI-ის ნაგულისხმევ 128M-ს ნაკრები 2026-09-19-ს
             მიაღწია და შედეგი **ტესტის ჩავარდნა არ იყო**: პროცესი შუა
             გზაზე კვდებოდა („Premature end of PHP process") ყოველ ჯერზე
             **სხვა** ტესტზე, ე.ი. ბრალდებული შემთხვევითი იყო.
             ⚠️ ამიტომაა აქ და არა ბრძანების სტრიქონში: ლოკალურ გაშვებასა
             და CI-ს ერთი და იგივე ჭერი უნდა ჰქონდეს, თორემ წითლდება
             მხოლოდ ერთი მათგანი. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- ⚠️ ცოცხალი გასაღები ტესტებში არასდროს: `.env`-ში ჩასმული
             `GEMINI_API_KEY` ნამდვილ კვოტას დახარჯავდა და თარჯიმნის
             „კონფიგურირებულია თუ არა" ტესტებს დეველოპერის მანქანაზე
             დამოკიდებულს გახდიდა. თითოეული ტესტი კლავიშს თვითონ სვამს. -->
        <env name="GEMINI_API_KEY" value=""/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
