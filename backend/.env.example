APP_NAME=Mediary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────
# MySQL (recommended — import backend/mediary_backup.sql). Create an empty
# database named `mediary` first, then run: php artisan migrate  OR import the backup.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediary
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

# ── TMDB (real posters / cast / descriptions) ─────────────
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Gemini translation (EN↔KA, Tasks 7) ────────────────
# Free key, no credit card: https://aistudio.google.com/apikey
# ~1500 requests/day on the free tier; the whole library is ~360.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# ჩვენი აღრიცხვის ჭერი (Google-ს ხარჯვის API არ აქვს); 0 = ულიმიტო
GEMINI_DAILY_LIMIT=1500
GEMINI_RPM_LIMIT=15

# Sanctum SPA (cookie) auth - frontend dev server
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1
ALLOW_REGISTRATION=true

# Public profiles (Tasks 16.1) - /u/{username} is readable WITHOUT login.
# Set to false to switch the whole mechanism off; per-user settings stay untouched.
PUBLIC_PROFILES=true

# YouTube Data API v3 (optional) - video duration + tags; title/thumbnail work without it
YOUTUBE_API_KEY=

# RAWG.io (optional) - games enrichment; the module works without it (manual entry)
RAWG_API_KEY=

# SerpApi (Tasks 7.6) - image / video / book search engines behind ONE key.
# Optional: without it those sources are simply hidden and everything else works.
# The 250/month Free Plan cap belongs to the ACCOUNT, not to a single engine, so
# images, videos and books all spend the same budget. The real remaining number
# comes from GET https://serpapi.com/account (that call does not spend a search);
# SERPAPI_MONTHLY_LIMIT is only our own accounting ceiling. https://serpapi.com
SERPAPI_KEY=
SERPAPI_MONTHLY_LIMIT=250

# Google Programmable Search (Tasks 7.5, source "a") - actor photos by tag.
# Optional: without BOTH values that source is hidden; the catalogue and scraping
# sources keep working. https://programmablesearchengine.google.com (image search on)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# yt-dlp (Tasks 7.1) - download a video into the local library.
# ⚠️ PHP cannot do this; an external program is required. Leave both empty and the
# download button says "source unavailable" (503 ytdlp_unavailable) instead of
# breaking silently - the same rule RAWG_API_KEY follows. If the binaries are on
# PATH they are found automatically and these may stay empty.
# ⚠️ ffmpeg is OPTIONAL but decides quality: without it separate video+audio
# streams cannot be merged, so "best available" falls back to the best single
# (progressive) file. What actually arrived is stored in videos.download_format.
YTDLP_BINARY=
FFMPEG_BINARY=
YTDLP_TIMEOUT=1800
YTDLP_PROBE_TIMEOUT=60

# Serper.dev — Google Images ფოტოძებნაში. ⚠️ თითო გვერდი = ერთი credit.
SERPER_API_KEY=
