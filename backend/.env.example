APP_NAME=Mediary
APP_ENV=local
APP_KEY=
# Tasks SEC-11 — safe by default: on a server APP_DEBUG=true prints a stack
# trace, the config and query fragments on every 500. setup.sh / setup.ps1
# turn it on for a local install; do NOT flip it here.
APP_DEBUG=false
# Tasks §8 — ლოკაციის დრო; სერვერის გადატანა ერთი ხაზია
APP_TIMEZONE=Asia/Tbilisi
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────
# MySQL. Run: php artisan migrate --seed (it offers to create a missing `mediary`
# database). No dump is committed (Tasks SEC-01) — move data with /backups.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediary
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Tasks SEC-11 — the session cookie is the login itself (Sanctum cookie mode),
# so it must never travel over plain HTTP. `config/session.php` reads
# SESSION_SECURE_COOKIE with no default, i.e. leaving it out means "not secure".
# ⚠️ A local install runs on http://, where a secure cookie is simply not sent
# and login stops working — setup.sh / setup.ps1 therefore set this to false
# for local development. Leave it true here.
SESSION_SECURE_COOKIE=true
# lax is also Laravel's own default; written out so it is a visible decision
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

# ── External source keys (TMDB, Gemini, RAWG, IGDB, SerpApi, Serper, YouTube, Telegram) ──
# ⚠️ They are NOT configured here any more (Tasks §30, 2026-09-28): every key
# belongs to the person who uses it and is entered on the "Credentials" page
# (/credentials), stored encrypted per user. The app does not read them from this
# file at all, so an empty line here would only invite a key nobody reads.
# `php artisan mediary:doctor` FAILs if one is left in backend/.env.
# Non-secret defaults (Gemini model, daily/monthly limits) live in code:
# App\Support\CredentialProviders.

# Sanctum SPA (cookie) auth - frontend dev server
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1
ALLOW_REGISTRATION=true

# First registered account becomes super_admin (Tasks SEC-15).
# Set to false on a public server: with open registration whoever
# registers first owns the installation. Then the only way to make an
# admin is `php artisan mediary:bootstrap-admin`.
FIRST_USER_IS_ADMIN=true

# Public profiles (Tasks 16.1) - /u/{username} is readable WITHOUT login.
# Set to false to switch the whole mechanism off; per-user settings stay untouched.
PUBLIC_PROFILES=true

# yt-dlp (Tasks 7.1) - download a video into the local library.
# ⚠️ PHP cannot do this; an external program is required. Leave both empty and the
# download button says "source unavailable" (503 ytdlp_unavailable) instead of
# breaking silently. If the binaries are on
# PATH they are found automatically and these may stay empty.
# ⚠️ ffmpeg is OPTIONAL but decides quality: without it separate video+audio
# streams cannot be merged, so "best available" falls back to the best single
# (progressive) file. What actually arrived is stored in videos.download_format.
#
# ⚠️ NEITHER NEEDS AN ELEVATED SHELL, contrary to what the backlog assumed until
# 2026-09-14. On this machine both were installed as the ordinary user:
#   yt-dlp:  pip install --user yt-dlp
#            -> %APPDATA%\Python\Python312\Scripts\yt-dlp.exe
#   ffmpeg:  the gyan.dev static build, unzipped into
#            %LOCALAPPDATA%/Programs/ffmpeg-<version>-essentials_build/bin/
# Neither lands on PATH, which is why the full paths are written below:
# ExecutableFinder would not find them and available() would stay false.
YTDLP_BINARY=
FFMPEG_BINARY=
YTDLP_TIMEOUT=1800
YTDLP_PROBE_TIMEOUT=60

# ─── ბაზის დამპი და აღდგენა (Tasks §22) ─────────────────
# ⚠️ ორივე **არასავალდებულოა**: ცარიელი ნიშნავს „მოძებნე" — ჯერ PATH, მერე
# ცნობილი საქაღალდეები (`DatabaseDumper::COMMON_PATHS`, სადაც `C:/xampp/mysql/bin`
# პირველია). ამ მანქანაზე ორივე ასე იპოვება და ჩაწერა საჭირო არაა.
# ⚠️ არქონა ავარია არაა: endpoint 503 `mysqldump_unavailable`-ს აბრუნებს და
# ინტერფეისი ამას წინასწარ წერს.
MYSQLDUMP_BINARY=
MYSQL_BINARY=
# წამები: სრული დამპი ან აღდგენა წუთებს გრძელდება
BACKUP_TIMEOUT=900
