{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */

    /* ⚠️ **strict-ის გარეშე `tsc -b` implicit `any`-ს და `null`-ის non-nullable
       პოზიციაში გადინებას ჩუმად უშვებდა** (Tasks DEBT-01) — ე.ი. ყოველი
       `?? null`/`?.` კონვენცია იყო და არა შემოწმება.

       ⚠️ **ჩართვამ არცერთი შეცდომა არ გამოიღო**: კოდი უკვე ასე იყო დაწერილი
       (`any`/`@ts-ignore` პროექტში ნულია). ე.ი. ეს დღევანდელი გასწორება კი
       არაა, არამედ **ბოქლომი** — რომ ხვალ დაწერილი `function f(x)` აღარ
       გაიაროს. გადამოწმდა ცხადად: დროებითმა `f(x)`-მა და `const s: string =
       null`-მა TS7006/TS2322 დააბრუნა.

       ⚠️ **`noUncheckedIndexedAccess` განზრახ არ ჩაირთო.** გაზომილი: 37
       შეცდომა 19 ფაილში, და მათი დიდი ნაწილი `if (xs.length) xs[0]`-ის
       ფორმისაა — უსაფრთხო, უბრალოდ კომპილატორისთვის უხილავი. მისი ჩვეული
       პასუხი `!`-ია, რაც შემოწმებას თვითონვე აუქმებს: ხმაური დაემატებოდა,
       უსაფრთხოება — არა. */
    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
