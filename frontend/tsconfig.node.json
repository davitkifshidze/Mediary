{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    // Tasks DEBT-01 — კონფიგიც იმავე წესზე დგას, რაზეც `src`
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* ⚠️ `vitest.config.ts`-ს **არაფერი ამოწმებდა** (DEBT-01): `tsconfig.app.json`
     მხოლოდ `src`-ს იღებს, აქ კი ის ჩამონათვალში არ იყო. ე.ი. ტესტების
     კონფიგში შეცდომა მხოლოდ გაშვებისას გამოჩნდებოდა. */
  "include": ["vite.config.ts", "vitest.config.ts"]
}
