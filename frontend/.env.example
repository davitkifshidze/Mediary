# Base URL of the Laravel API (backend). No trailing slash.
#
# ⚠️ Leave it EMPTY when the SPA and the API share one origin — a reverse proxy
# in development, or the single vhost the README's "Production" section
# describes. Sanctum's cookie auth needs same-origin, and an empty value means
# a relative `/api`.
VITE_API_URL=http://localhost:8000

# Host name the dev server is reached by, when Vite sits behind a proxy
# (Apache/nginx on port 80) instead of being opened at 127.0.0.1:5173.
#
# ⚠️ Leave it EMPTY unless that proxy exists (Tasks GAP-17). It used to be
# hardcoded to `mediary.local`, so on any machine without that hosts entry the
# browser opened the HMR websocket against a name that does not resolve and hot
# reload **failed silently** — the page still loaded, saving a file just stopped
# doing anything.
VITE_DEV_HOST=
